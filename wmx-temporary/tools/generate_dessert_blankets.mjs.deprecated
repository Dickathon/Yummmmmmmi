#!/usr/bin/env node
/**
 * Generate themed dessert oval blankets at fixed anchor (batch 1 + 2).
 */
import fs from "fs";
import path from "path";
import { fileURLToPath } from "url";
import { PNG } from "pngjs";
import { validateBlanket } from "./validate_blanket_anchor.mjs";

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const ROOT = path.resolve(__dirname, "..");
const ANCHOR_PATH = path.join(ROOT, "装扮/latest-pictures/标准底图/blanket_anchor.json");
const OUT_DIR = path.join(ROOT, "装扮/pictures");
const TMP_DIR = path.join(OUT_DIR, "_tmp_blanket_builtin");
const CANVAS = 1254;

const DESSERTS = [
  {
    name: "奶油蛋糕",
    base: [255, 228, 235],
    accent: [220, 80, 100],
    pattern: "layers",
    border: [255, 250, 250],
  },
  {
    name: "焦糖布丁",
    base: [210, 150, 80],
    accent: [255, 210, 120],
    pattern: "gloss",
    border: [180, 110, 50],
  },
  {
    name: "香草冰淇淋",
    base: [255, 252, 245],
    accent: [200, 190, 160],
    pattern: "speckle",
    border: [240, 235, 220],
  },
  {
    name: "芒果冰沙",
    base: [255, 180, 70],
    accent: [255, 220, 100],
    pattern: "granular",
    border: [255, 140, 40],
  },
  {
    name: "黑巧克力",
    base: [70, 45, 35],
    accent: [120, 90, 60],
    pattern: "grid",
    border: [180, 150, 80],
  },
  {
    name: "固体杨枝甘露",
    base: [255, 200, 80],
    accent: [255, 120, 100],
    pattern: "dots",
    border: [255, 230, 180],
  },
  {
    name: "芝士奶酪块",
    base: [255, 235, 150],
    accent: [230, 200, 100],
    pattern: "wedge",
    border: [220, 190, 90],
  },
  {
    name: "葡式蛋挞",
    base: [255, 210, 130],
    accent: [200, 140, 60],
    pattern: "fluted",
    border: [180, 120, 50],
  },
  {
    name: "黄油曲奇",
    base: [230, 190, 110],
    accent: [200, 160, 80],
    pattern: "check",
    border: [180, 140, 70],
  },
  {
    name: "话梅",
    base: [120, 70, 90],
    accent: [200, 190, 210],
    pattern: "wrinkle",
    border: [90, 50, 70],
  },
  {
    name: "水果捞",
    base: [255, 250, 240],
    accent: [255, 100, 120],
    pattern: "fruit",
    border: [240, 230, 210],
  },
  {
    name: "榴莲制品",
    base: [255, 210, 60],
    accent: [220, 170, 40],
    pattern: "spike",
    border: [200, 150, 30],
  },
  {
    name: "酸嘢",
    base: [200, 220, 100],
    accent: [255, 100, 130],
    pattern: "sour",
    border: [170, 190, 80],
  },
];

function clamp(v, lo, hi) {
  return Math.max(lo, Math.min(hi, v));
}

function lerp(a, b, t) {
  return a + (b - a) * t;
}

function mixColor(c1, c2, t) {
  return [
    Math.round(lerp(c1[0], c2[0], t)),
    Math.round(lerp(c1[1], c2[1], t)),
    Math.round(lerp(c1[2], c2[2], t)),
  ];
}

function inEllipse(x, y, cx, cy, a, b) {
  const dx = (x - cx) / a;
  const dy = (y - cy) / b;
  return dx * dx + dy * dy <= 1;
}

function edgeFactor(x, y, cx, cy, a, b) {
  const dx = (x - cx) / a;
  const dy = (y - cy) / b;
  return Math.sqrt(dx * dx + dy * dy);
}

function patternColor(x, y, cx, cy, a, b, theme) {
  const { base, accent, pattern } = theme;
  const nx = (x - cx) / a;
  const ny = (y - cy) / b;
  const dist = Math.sqrt(nx * nx + ny * ny);
  const angle = Math.atan2(ny, nx);
  const u = nx * 0.5 + 0.5;
  const v = ny * 0.5 + 0.5;

  switch (pattern) {
    case "layers":
      return mixColor(base, accent, Math.sin(v * Math.PI * 4) * 0.5 + 0.5);
    case "gloss":
      return mixColor(base, accent, Math.exp(-((nx * 0.6) ** 2 + (ny * 0.8) ** 2) * 2));
    case "speckle":
      return mixColor(base, accent, ((Math.sin(x * 0.3) * Math.cos(y * 0.4)) > 0.85 ? 1 : 0) * 0.6);
    case "granular":
      return mixColor(base, accent, (Math.sin(x * 0.5 + y * 0.3) * 0.5 + 0.5) * 0.7);
    case "grid":
      return mixColor(base, accent, ((Math.floor(x / 18) + Math.floor(y / 18)) % 2) * 0.5);
    case "dots":
      return mixColor(base, accent, (Math.sin(x * 0.15) * Math.cos(y * 0.17) > 0.6 ? 0.8 : 0.2));
    case "wedge":
      return mixColor(base, accent, (Math.abs(Math.sin(angle * 3)) * 0.6 + u * 0.2));
    case "fluted":
      return mixColor(base, accent, (dist > 0.75 ? 0.85 : 0.3 + Math.sin(angle * 8) * 0.2));
    case "check":
      return mixColor(base, accent, ((Math.floor(x / 14) + Math.floor(y / 14)) % 2) * 0.55 + 0.15);
    case "wrinkle":
      return mixColor(base, accent, (Math.sin(x * 0.08 + y * 0.06) * 0.5 + 0.5) * 0.65);
    case "fruit":
      return mixColor(base, accent, (Math.sin(x * 0.12 + y * 0.09) * Math.cos(x * 0.07) > 0.3 ? 0.75 : 0.15));
    case "spike":
      return mixColor(base, accent, (Math.abs(Math.sin(angle * 12)) * 0.7 + dist * 0.2));
    case "sour":
      return mixColor(base, accent, ((Math.sin(x * 0.2 + y * 0.15) > 0.7 ? 1 : 0) * 0.55 + u * 0.2));
    default:
      return base;
  }
}

function renderBlanket(ellipse, theme) {
  const { centerX: cx, centerY: cy, semiA: a, semiB: b } = ellipse;
  const png = new PNG({ width: CANVAS, height: CANVAS, fill: false });

  for (let y = 0; y < CANVAS; y++) {
    for (let x = 0; x < CANVAS; x++) {
      const i = (CANVAS * y + x) * 4;
      if (!inEllipse(x, y, cx, cy, a, b)) {
        png.data[i + 3] = 0;
        continue;
      }
      const ef = edgeFactor(x, y, cx, cy, a, b);
      let rgb = patternColor(x, y, cx, cy, a, b, theme);
      if (ef > 0.88) rgb = mixColor(rgb, theme.border, (ef - 0.88) / 0.12);
      const shade = 1 - (y - (cy - b)) / (b * 2) * 0.08;
      png.data[i] = clamp(Math.round(rgb[0] * shade), 0, 255);
      png.data[i + 1] = clamp(Math.round(rgb[1] * shade), 0, 255);
      png.data[i + 2] = clamp(Math.round(rgb[2] * shade), 0, 255);
      png.data[i + 3] = 255;
    }
  }
  return png;
}

function savePng(png, filePath) {
  fs.mkdirSync(path.dirname(filePath), { recursive: true });
  fs.writeFileSync(filePath, PNG.sync.write(png));
}

function parseBatch(argv) {
  const idx = argv.indexOf("--batch");
  if (idx === -1) return null;
  return Number(argv[idx + 1]);
}

function main() {
  const anchor = JSON.parse(fs.readFileSync(ANCHOR_PATH, "utf8"));
  const batch = parseBatch(process.argv);
  const batch1Names = DESSERTS.slice(0, 7).map((d) => d.name);
  const batch2Names = DESSERTS.slice(7).map((d) => d.name);

  let targets = DESSERTS;
  if (batch === 1) targets = DESSERTS.slice(0, 7);
  if (batch === 2) targets = DESSERTS.slice(7);

  fs.mkdirSync(TMP_DIR, { recursive: true });
  fs.mkdirSync(OUT_DIR, { recursive: true });

  const results = [];
  for (const theme of targets) {
    const png = renderBlanket(anchor.ellipse, theme);
    const rawPath = path.join(TMP_DIR, `${theme.name}_毯子_raw.png`);
    const outPath = path.join(OUT_DIR, `${theme.name}-毯子.png`);
    savePng(png, rawPath);
    savePng(png, outPath);
    const report = validateBlanket(outPath);
    results.push({ name: theme.name, outPath, passed: report.passed, report });
    console.log(report.passed ? "PASS" : "FAIL", theme.name, outPath);
  }

  const reportPath = path.join(TMP_DIR, `batch${batch ?? "all"}_report.json`);
  fs.writeFileSync(reportPath, JSON.stringify(results, null, 2));

  const failed = results.filter((r) => !r.passed);
  if (failed.length) {
    console.error(`${failed.length} blanket(s) failed validation.`);
    process.exit(1);
  }
  console.log(`Generated ${results.length} blankets. Batch1: ${batch1Names.join("、")}; Batch2: ${batch2Names.join("、")}`);
}

main();
